# Engram Environment Configuration

# Core Application Settings
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Cognee Configuration
# --------------------
# We use custom endpoints (like NVIDIA or local vLLM).
# LITELMM requires this tokenizer setting to avoid mapping errors for custom endpoints.
LITELLM_TOKENIZER=cl100k_base

# The unified dataset name for the current project context
COGNEE_DATASET_NAME=engram_core

# LLM Configuration (Gemini Flash or NVIDIA fallback)
COGNEE_LLM_PROVIDER=openai
COGNEE_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
COGNEE_LLM_ENDPOINT=https://integrate.api.nvidia.com/v1
COGNEE_LLM_API_KEY=your_api_key_here

# Embeddings Configuration
COGNEE_EMBEDDING_PROVIDER=openai
COGNEE_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
COGNEE_EMBEDDING_ENDPOINT=https://integrate.api.nvidia.com/v1
COGNEE_EMBEDDING_API_KEY=your_api_key_here
